# Radar — ortam değişkenleri örneği
#
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur. `.env` git'te izlenmez.
# Bu dosyaya ASLA gerçek bir anahtar veya parola yazma (CLAUDE.md kural 4);
# buradaki değerler yalnızca yerel geliştirme için yer tutucudur.

# --- Postgres (docker-compose bu üçünü konteyneri kurarken kullanır) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=radar
POSTGRES_PORT=5432

# --- Uygulama bağlantıları ---
# Host makineden çalıştırırken sunucu adı `localhost`, docker compose içinde
# servis adıdır (`postgres` / `redis`).
DATABASE_URL=postgresql+asyncpg://radar:change-me-locally@postgres:5432/radar
REDIS_URL=redis://redis:6379/0

REDIS_PORT=6379
API_PORT=8000

APP_ENV=development

# Panelin (web/) API'ye tarayıcıdan istek atabilmesi için CORS. Virgülle ayrılmış
# açık origin listesi. Boş bırakılırsa varsayılan http://localhost:3000 kullanılır.
CORS_ALLOW_ORIGINS=

# --- Sonraki fazlarda eklenecek anahtarlar ---
# Aşağıdakiler Faz 1'de okunmuyor; ilgili faz gelince yorumdan çıkarılır ve
# `api/config.py` içindeki Settings sınıfına alanı eklenir.
#
# Faz 2 — veri kaynakları (SPEC §2):
# GOOGLE_PLACES_API_KEY=
# IG_BUSINESS_DISCOVERY_TOKEN=
# APIFY_TOKEN=
#
# Faz 4 — LLM katmanı (SPEC §6):
# ANTHROPIC_API_KEY=
